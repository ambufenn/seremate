# GEMINI_API_KEY: Required for server-side Gemini AI Health Companion calls.
# Configured automatically via AI Studio Secrets or environment variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SEREMATE_AI_MODEL: Configurable Gemini model ID (default: gemini-4-hydrogen).
SEREMATE_AI_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this application is hosted.
APP_URL="MY_APP_URL"
